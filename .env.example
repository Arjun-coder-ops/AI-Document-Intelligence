# ==============================================================================
# DocSage Environment Specification (.env.example)
# Copy to .env for local development. Never commit real credentials.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=8000
WEB_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Database (Neon PostgreSQL with pgvector)
# Use POOLED connection for application runtime (transaction RLS safe)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docsage
# Use DIRECT connection for migrations / DDL scripts
DATABASE_URL_DIRECT=postgresql://postgres:postgres@localhost:5432/docsage

# Cache & Rate Limiting (Upstash / Redis)
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Authentication (Argon2id + JWT)
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_32_chars_min
JWT_REFRESH_SECRET=replace_with_another_cryptographically_secure_random_string_32_chars_min
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# RAG & Embeddings
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Primary LLM Provider (Groq)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# Secondary Fallback & Embedding Provider (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-1.5-flash

# Reranker Provider (Optional Cohere / Jina API, or listwise LLM fallback)
RERANKER_PROVIDER=local_or_llm
COHERE_API_KEY=

# Storage and Ingestion
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# Ingestion & Retrieval Configuration
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
RETRIEVAL_TOP_K_DENSE=25
RETRIEVAL_TOP_K_LEXICAL=25
RETRIEVAL_TOP_K_RERANK=5
RELEVANCE_SCORE_THRESHOLD=0.45
HNSW_EF_SEARCH=64
