# ==============================================================================
# DocSage Environment Specification (.env.example)
# Exactly 8 required environment variables for production & local execution.
# ==============================================================================

# 1. Neon POOLED connection string (connecting as app_user, RLS enforced)
DATABASE_URL=postgresql://app_user:app_user_secret@localhost:5432/docsage

# 2. Neon DIRECT connection string (connecting as owner, migrations only)
DATABASE_URL_DIRECT=postgresql://postgres:postgres@localhost:5432/docsage

# 3. Access Token HMAC secret (minimum 32 characters)
JWT_ACCESS_SECRET=replace_with_a_cryptographically_secure_random_string_32_chars_min

# 4. Refresh Token HMAC secret (minimum 32 characters)
JWT_REFRESH_SECRET=replace_with_another_cryptographically_secure_random_string_32_chars_min

# 5. Primary LLM Provider API Key (Groq Llama 3.3 70B)
GROQ_API_KEY=gsk_your_groq_api_key_here

# 6. Secondary Fallback, Embedding, and Reranking API Key (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# 7. Multi-Tier Cache & Rate Limiting (Redis / Upstash)
REDIS_URL=redis://localhost:6379

# 8. Vector Embedding Dimension (768 for models/gemini-embedding-001)
EMBEDDING_DIM=768
