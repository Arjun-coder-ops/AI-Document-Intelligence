      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(docsage_stage_latency_seconds_bucket{stage=\"llm_ttft\"}[5m])) by (le))",
          "legendFormat": "TTFT p95"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(docsage_stage_latency_seconds_bucket{stage=\"llm_total\"}[5m])) by (le))",
