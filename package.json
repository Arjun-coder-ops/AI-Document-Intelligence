{
  "name": "docsage-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-grade multi-tenant RAG document intelligence platform",
  "workspaces": [
    "packages/*",
    "apps/*",
    "evals"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "eval": "npm --workspace=@docsage/evals run eval",
    "eval:retrieval": "npm --workspace=@docsage/evals run eval:retrieval",
    "test:load": "npm --workspace=@docsage/evals run test:load",
    "db:setup-roles": "npm --workspace=@docsage/db run db:setup-roles",
    "knip": "knip",
    "jscpd": "jscpd packages apps evals",
    "screens:capture": "tsx scripts/capture-screens.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.13.5",
    "@vitest/coverage-v8": "^3.0.7",
    "drizzle-orm": "^0.45.4",
    "eslint": "^9.21.0",
    "husky": "^9.1.7",
    "jscpd": "^4.3.0",
    "knip": "^5.88.1",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
